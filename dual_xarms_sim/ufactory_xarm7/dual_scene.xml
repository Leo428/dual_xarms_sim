<mujoco model="dual_xarm7 scene">
  <include file="dual_xarm7_nohand.xml" />

  <option timestep=".002" noslip_iterations="5" noslip_tolerance="0"/>
  <statistic center="0.2 0 0.4" extent=".65" meansize="0.08" />

  <visual>
    <headlight diffuse="0.3 0.3 0.3" ambient="0.3 0.3 0.3" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="150" elevation="-20" />
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512"
      height="512" mark="cross" markrgb=".8 .8 .8" />
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" />
  </asset>

  <worldbody>
    <light pos="0 0 5" />
    <geom name="floor" size="1 1 0.01" type="plane" material="grid" />
    <body name="left/target" pos="-0.35 0.4 .1" quat="0 0.7071068 -0.7071068 0" mocap="true">
      <geom type="box" size=".03 .03 .03" contype="0" conaffinity="0" rgba=".6 .3 .3 .25" />
    </body>
    <body name="right/target" pos="0.35 0.4 .1" quat="0 0.7071068 -0.7071068 0" mocap="true">
      <geom type="box" size=".03 .03 .03" contype="0" conaffinity="0" rgba=".3 .3 .6 .25" />
    </body>
    <body name="block" pos="0 0.4 .02">
      <freejoint name="block" />
      <geom name="block" type="box" size=".03 .03 .03" mass="0.1" rgba=".6 .3 .6 1" />
    </body>
  </worldbody>

  <sensor>
    <framepos name="block_pos" objtype="geom" objname="block" />
    <framequat name="block_quat" objtype="geom" objname="block" />
  </sensor>
</mujoco>